# Live exam stack (wmc.ms.wits.ac.za). The API is served on :8080; the host's :80/:443
# reverse proxy returns 503, so the port is not optional. Credentials are provided by the exam.
MQTT_BROKER_ADDRESS=wmc.ms.wits.ac.za
MQTT_BROKER_PORT=1883
MQTT_BROKER_USER=student
MQTT_BROKER_PASSWORD=arl-exam
ARL_API_ADDRESS=wmc.ms.wits.ac.za
ARL_API_PORT=8080

# Platform server (optional; defaults live in server/src/config.ts)
SERVER_HOST=127.0.0.1
SERVER_PORT=4000
WEB_ORIGIN=http://localhost:5173
DB_PATH=server/data/arl.sqlite
