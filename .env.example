# Copy to .env (never commit .env). Local podman stack values shown.
MQTT_BROKER_ADDRESS=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_USER=
MQTT_BROKER_PASSWORD=
ARL_API_ADDRESS=localhost
ARL_API_PORT=8080

# Platform server (optional; defaults live in server/src/config.ts)
SERVER_HOST=127.0.0.1
SERVER_PORT=4000
WEB_ORIGIN=http://localhost:5173
DB_PATH=server/data/arl.sqlite
